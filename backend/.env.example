# Copy this file to .env and paste your Gnani API key locally.
GNANI_API_KEY=PASTE_YOUR_GNANI_API_KEY_HERE

# Current public Timbre example settings. Change only if your Gnani dashboard/docs show different values.
TIMBRE_MODEL=vachana-voice-v3
TIMBRE_VOICE=Karan

# Optional: Vision API key for automated Crop Doctor leaf image classification
VISION_API_KEY=

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
